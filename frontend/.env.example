# PostgreSQL: use the provider's pooled URL on Vercel.
DATABASE_URL=postgresql://grammar_tracker:grammar_tracker@localhost:5432/grammar_tracker
DATABASE_POOL_MAX=10

# OpenAI model names are fixed in code for production parity.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=1

# Preserve the existing secret and TTL for live-session continuity.
JWT_SECRET=
SESSION_TTL_MINUTES=60

# Exact rolling analysis-attempt limits.
ANALYSIS_MINUTE_LIMIT=3
ANALYSIS_DAY_LIMIT=20
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# A private Vercel Blob connected store supplies these values automatically.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
BLOB_WEBHOOK_PUBLIC_KEY=

# Protects the orphaned-staging-blob cleanup endpoint.
CRON_SECRET=

# `deterministic` is permitted only outside Vercel production.
ANALYZER_MODE=openai
LOG_LEVEL=info
