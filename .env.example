DATABASE_URL=postgresql://grammar_tracker:grammar_tracker@localhost:5432/grammar_tracker
DATABASE_POOL_MAX=10

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=1

JWT_SECRET=
SESSION_TTL_MINUTES=60

ANALYSIS_MINUTE_LIMIT=3
ANALYSIS_DAY_LIMIT=20

# `deterministic` is permitted only outside Vercel production
ANALYZER_MODE=openai

LOG_LEVEL=info

# The following values must be set in a root .env file when running locally or testing E2E

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# The private Vercel Blob connected store supplies these values automatically in production
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
BLOB_WEBHOOK_PUBLIC_KEY=