DATABASE_URL="postgresql://grammar_tracker:grammar_tracker@localhost:5432/grammar_tracker"
DATABASE_POOL_MAX="5"

ANALYZER_MODE="deterministic"

# OpenAI API settings are optional with `deterministic` analyzer
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TIMEOUT_MS="60000"
OPENAI_MAX_RETRIES="1"

JWT_SECRET=
SESSION_TTL_MINUTES="60"

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ANALYSIS_MINUTE_LIMIT="3"
ANALYSIS_DAY_LIMIT="20"

LOG_LEVEL="debug"

# Vercel supplies these values automatically
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=
BLOB_WEBHOOK_PUBLIC_KEY=